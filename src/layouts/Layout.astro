---
const { title = 'Villanyszerelés' } = Astro.props;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Villanyszerelési szolgáltatások Budapesten és környékén."
		/>
		<title>{title}</title>
	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		color: #171717;
		background: #f7f7f5;
	}

	a {
		color: inherit;
	}
</style>