---
import CopyContact from './CopyContact.astro';
---

<section id="kapcsolat" class="section contact">
	<div class="container contact-inner">
		<div>
			<p class="eyebrow">Kapcsolat</p>
			<h2>Van egy problémád?</h2>
			<p class="message">
				Hívj vagy küldj e-mailt, és egyeztessünk a feladatról!
			</p>
		</div>

		<div class="contact-details">
			<CopyContact type="phone" value="+36 12 3456 789" />
			<CopyContact type="email" value="barabasi.business@gmail.com" />
		</div>
	</div>
</section>

<style>
	.section {
		padding: 120px 0;
	}

	.container {
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
	}

	.contact {
		background: var(--color-muted);
	}

	.message {
		color: var(--color-electric);
	}

	h2 {
		margin: 0 0 50px;
		font-size: clamp(36px, 5vw, 60px);
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--color-ink);
	}

	.contact-inner {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 50px;
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
		font-size: 24px;
		font-weight: 700;
		color: var(--color-white);
	}

	@media (max-width: 800px) {
		.contact-inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.contact-details {
			align-items: flex-start;
		}
	}

	@media (max-width: 500px) {
		.container {
			width: min(100% - 28px, 1120px);
		}

		.section {
			padding: 80px 0;
		}
	}
</style>