---
interface Props {
    icon: string;
    title: string;
    description: string;
}

const { icon, title, description } = Astro.props;
---

<article class="service-card">
    <div class="service-icon">{icon}</div>
    <h3>{title}</h3>
    <p>{description}</p>
</article>

<style>
    .service-card {
        padding: 28px;
        background: color-mix(in srgb, var(--color-electric) 25%, transparent);
        border: 1px solid var(--color-electric);
        border-radius: 12px;
    }

    .service-icon {
        font-size: 28px;
        margin-bottom: 40px;
    }

    h3 {
        margin: 0 0 12px;
        font-size: 20px;
        color: var(--color-ink);
    }

    p {
        margin: 0;
        line-height: 1.6;
        color: var(--color-cream);
    }
</style>