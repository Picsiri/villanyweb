---
import logo from '../assets/BVillam_noBG.svg';
---

<section class="hero">
	<div class="container hero-inner">
		<div class="hero-content">
			<div class="hero-heading">
				<img class="hero-logo" src={logo.src} alt="B-Villam villanyszerelés logója" />
				<h1>
					Intelligens<br />
					<span>villanyszerelés.</span>
				</h1>
			</div>

			<p class="hero-text">
				intelligens otthon, villamos kiépítés, hibakeresés, javítás<br />
				szakszerűen, átláthatóan, dokumentáltan
			</p>

		</div>
	</div>
</section>

<style>
	.container {
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
	}

	.hero {
		min-height: 720px;
		display: flex;
		align-items: center;
		background: var(--color-cream);
	}

	.hero-inner {
		padding-top: 50px;
	}

	.hero-content {
		max-width: 100%;
	}

	.hero-heading {
		display: flex;
		align-items: center;
		gap: 0.28em;
		font-size: clamp(42px, 8vw, 100px);
	}

	.hero-logo {
		display: block;
		width: 1.9em;
		height: auto;
		flex: 0 0 auto;
	}

	h1 {
		margin: 0;
		font-size: inherit;
		line-height: 0.95;
		letter-spacing: -0.065em;
		color: var(--color-ink);
	}

	h1 span {
		color: var(--color-electric);
	}

	.hero-text {
		max-width: 560px;
		margin: 32px 0;
		font-size: 20px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	@media (max-width: 500px) {
		.container {
			width: min(100% - 28px, 1120px);
		}

		.hero-heading {
			gap: 0.3em;
			font-size: clamp(28px, 8vw, 40px);
		}

		.hero {
			min-height: 650px;
		}
	}
</style>